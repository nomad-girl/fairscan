# ─── Build NATIVO (Capacitor) ──────────────────────────────────────────
# Lo carga `npm run build:native` (= `vite build --mode native`) ENCIMA de `.env`.
# Solo valores públicos: este archivo SÍ se commitea. Las claves siguen en `.env`.

# Sin service worker: Capacitor ya deja los archivos en el teléfono.
VITE_NATIVE=1

# La app empaquetada se sirve desde el propio teléfono, así que las llamadas a
# /api/... tienen que ir con el dominio completo. Sin esto, toda la IA queda muda.
VITE_API_BASE=https://fairscan.app

# Compras (pieza 5.4): claves PÚBLICAS de RevenueCat, una por tienda. Las crea Nati
# en app.revenuecat.com → Project → API keys. Son públicas por diseño (van en la app).
# VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxx
# VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx
