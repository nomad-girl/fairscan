{
  "appId": "com.builddigitalthings.fairscan",
  "appName": "FairScan",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false
  },
  "backgroundColor": "#2B1206",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1100,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#2B1206",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": false,
      "iosSpinnerStyle": "small",
      "showSpinner": false
    }
  }
}
