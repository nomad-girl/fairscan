# ─── FairScan · variables de entorno ─────────────────────────────────────
# Copiar a `.env` y completar. `.env` NUNCA se commitea.

# ─── Cliente (van al bundle: son públicas por definición) ────────────────

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=

# Dirección del servidor de las funciones.
#   Web (Netlify): dejar VACÍA. Las llamadas quedan relativas al propio dominio.
#   Builds nativos (Capacitor): poner el dominio de producción, ej.
#     VITE_API_BASE=https://fairscan.app
#   Sin esto, la app empaquetada busca /api/... adentro del teléfono y toda la IA
#   queda muda. Ver `auditoria-e2e.md` → F1.
VITE_API_BASE=

# Marca que el build es para la app nativa. Con "1", no se genera el service
# worker (Capacitor ya deja los archivos en el teléfono; dos cachés se pelean).
# NO va acá: vive en `.env.native`, que `npm run build:native` carga encima de
# este archivo (junto con VITE_API_BASE=https://fairscan.app). En web dejar vacía.
VITE_NATIVE=

# ─── Servidor (solo en el panel de Netlify, NO en el bundle) ─────────────
# Se listan acá para saber qué tiene que estar configurado allá.
#
# ANTHROPIC_API_KEY      clave de la API de Claude
# CLAUDE_MODEL           opcional; por defecto claude-haiku-4-5-20251001
#
# R2_ACCOUNT_ID          Cloudflare R2
# R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY
# R2_BUCKET_NAME
# R2_PUBLIC_URL          opcional; dominio público del bucket
#
# ALLOWED_ORIGINS        opcional; origenes extra separados por coma.
#                        Los de Capacitor, los de desarrollo y la URL del propio
#                        sitio de Netlify ya vienen incluidos por defecto.
#
# AUTH_MODE              "enforce" (por defecto) exige sesión válida en todos los
#                        endpoints. "warn" deja pasar y solo avisa en los logs:
#                        interruptor de emergencia si un deploy deja afuera a una
#                        app vieja que todavía no manda la sesión. Volver a
#                        "enforce" apenas se pueda.
