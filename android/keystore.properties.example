# Firma de release para Google Play (pieza 10.2). Copiar este archivo como
# android/keystore.properties (está en .gitignore: NUNCA se commitea) y completar.
#
# Crear la clave, UNA sola vez, desde la terminal (botón Run), en la carpeta web/android:
#   keytool -genkeypair -v -keystore fairscan-upload.jks -alias fairscan -keyalg RSA -keysize 2048 -validity 10000
# Guardar el .jks y las contraseñas en el gestor de contraseñas: si se pierden, no se
# puede actualizar la app en Play (salvo con Play App Signing, que conviene activar).
storeFile=fairscan-upload.jks
storePassword=CAMBIAR
keyAlias=fairscan
keyPassword=CAMBIAR
